@model OrchardCore.Templates.ViewModels.ThemeCustomizationViewModel

@{
    var localCustomizationCount = Model.ThemeTemplates.Count(x => x.HasLocalCustomization);
}

<zone Name="Title"><h1>@RenderTitleSegments(T["Theme Customization"])</h1></zone>

<div class="alert alert-info" role="alert">
    <p class="mb-0">@T["Bootstrap Liquid template customization from an existing front-end theme. This feature lists supported Liquid templates from the selected base theme and lets you clone local overrides without modifying the packaged theme files."]</p>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@T["Current Site Theme"]</dt>
            <dd class="col-sm-9">@Model.CurrentThemeName</dd>

            <dt class="col-sm-3">@T["Initialized"]</dt>
            <dd class="col-sm-9">@(Model.Initialized ? T["Yes"] : T["No"])</dd>

            @if (Model.Initialized)
            {
                <dt class="col-sm-3">@T["Base Theme"]</dt>
                <dd class="col-sm-9">@Model.BaseThemeName</dd>

                <dt class="col-sm-3">@T["Theme Templates"]</dt>
                <dd class="col-sm-9">@Model.ThemeTemplates.Count</dd>

                <dt class="col-sm-3">@T["Local Customizations"]</dt>
                <dd class="col-sm-9">@localCustomizationCount</dd>
            }
        </dl>
    </div>
</div>

@if (!Model.Initialized)
{
    <form asp-action="Initialize" method="post" class="no-multisubmit">
        <div class="card text-bg-theme mb-3 position-sticky action-bar">
            <div class="card-body p-3 text-end">
                <button type="submit" class="btn btn-primary save">@T["Initialize Customization"]</button>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="BaseThemeId" class="ocat-label">@T["Base Theme"]</label>
            <div class="ocat-end">
                <select asp-for="BaseThemeId" asp-items="Model.AvailableThemes" class="form-select">
                    <option value="">@T["Select a theme"]</option>
                </select>
                <span class="hint">@T["Only themes with supported Liquid templates are listed. The number in parentheses is the count of available theme templates."]</span>
            </div>
        </div>

        <div class="ocat-wrapper" asp-validation-class-for="CloneAllTemplatesOnInitialize">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="CloneAllTemplatesOnInitialize" class="form-check-input" />
                    <label asp-for="CloneAllTemplatesOnInitialize" class="form-check-label">@T["Clone all theme templates during initialization"]</label>
                </div>
                <span class="hint dashed">@T["Leave this unchecked to initialize first and decide template-by-template which local customizations to clone."]</span>
            </div>
        </div>
    </form>
}
else
{
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body p-3 text-end">
            <form asp-action="ReseedMissingTemplates" method="post" class="d-inline no-multisubmit">
                <button type="submit" class="btn btn-secondary">@T["Clone All Missing Templates"]</button>
            </form>
            <form asp-action="Reset" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger" data-title="@T["Reset Theme Customization"]" data-message="@T["Are you sure you want to remove the tracked local customizations created from this feature?"]">@T["Reset Customization"]</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            @T["Theme Templates"]
        </div>
        <div class="card-body p-0">
            @if (Model.ThemeTemplates.Count == 0)
            {
                <div class="p-3">@T["No supported theme templates were found for the selected base theme."]</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@T["Template"]</th>
                                <th>@T["Source"]</th>
                                <th>@T["Status"]</th>
                                <th class="text-end">@T["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var template in Model.ThemeTemplates)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@template.TemplateName</div>
                                    </td>
                                    <td><code>@template.RelativePath</code></td>
                                    <td>
                                        @if (template.HasLocalCustomization)
                                        {
                                            @if (template.IsTrackedCustomization)
                                            {
                                                <span class="badge text-bg-success">@T["Local customization"]</span>
                                                <span class="badge text-bg-secondary">@T["Tracked"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-warning">@T["Existing local template"]</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-light">@T["Theme default"]</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (!template.HasLocalCustomization)
                                        {
                                            <form asp-action="CloneTemplate" method="post" class="d-inline no-multisubmit">
                                                <input type="hidden" name="templateName" value="@template.TemplateName" />
                                                <button type="submit" class="btn btn-sm btn-primary">@T["Clone"]</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-controller="Template" asp-action="Edit" asp-route-name="@template.TemplateName" class="btn btn-sm btn-primary">@T["Edit"]</a>
                                            @if (template.IsTrackedCustomization)
                                            {
                                                <form asp-action="ResetTemplate" method="post" class="d-inline no-multisubmit">
                                                    <input type="hidden" name="templateName" value="@template.TemplateName" />
                                                    <button type="submit" class="btn btn-sm btn-secondary" data-title="@T["Reset Theme Template"]" data-message="@T["Are you sure you want to reset '{0}' to the packaged theme version?", template.TemplateName]">@T["Reset"]</button>
                                                </form>
                                                <form asp-action="DeleteTemplate" method="post" class="d-inline">
                                                    <input type="hidden" name="templateName" value="@template.TemplateName" />
                                                    <button type="submit" class="btn btn-sm btn-danger" data-title="@T["Delete Local Customization"]" data-message="@T["Are you sure you want to delete the local customization for '{0}'?", template.TemplateName]">@T["Delete"]</button>
                                                </form>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
