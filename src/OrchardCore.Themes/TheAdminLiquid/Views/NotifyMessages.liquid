{% styleblock at: "Head" %}
    .oc-notify-toast-container {
        inset-inline-start: auto;
        inset-inline-end: 1rem;
        /*top: calc(var(--oc-notify-offset-top, 0px) + .25rem);*/
        z-index: 1080;
    }
{% endstyleblock %}

<div class="toast-container position-fixed p-3 oc-notify-toast-container">
{%- for entry in Model.Entries %}
    {{ "Message" | shape_new: type: entry.Type, message: entry.Message, milliseconds: entry.DismissalMilliseconds | shape_render }}
{%- endfor %}
</div>

{% script src: "~/TheAdmin/js/notify-messages/NotifyMessages.min.js", debug_src: "~/TheAdmin/js/notify-messages/NotifyMessages.js", at: "Foot", type: "module" %}
