{%- shape_clear_alternates Model -%}
{%- shape_type Model "Pager_Link" -%}
{%- assign value = '<i class="fa-solid fa-angle-right"></i>' | html_content -%}
{%- shape_add_properties Model value: value -%}
{%- assign title = "Go to next page." | t -%}
{%- assign _ = Model.Tag | tag_merge_attribute: "title", title -%}
{{ Model | shape_render }}
